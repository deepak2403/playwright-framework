<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <!-- UI tests: parallel at method level -->
    <test name="UI Tests" parallel="methods" thread-count="2">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.EcommerceTest"/>
        </classes>
    </test>

    <!--
        E2E checkout: dependsOnMethods chain requires sequential execution.
        parallel="none" here overrides suite-level parallel for this test block.
    -->
    <test name="E2E Checkout" parallel="none">
        <groups>
            <run>
                <include name="e2e"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CheckoutTest"/>
        </classes>
    </test>

    <!-- API tests: no browser overhead, safe to run with more threads -->
    <test name="API Tests" parallel="methods" thread-count="3">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="tests.ApiTest"/>
        </classes>
    </test>

</suite>